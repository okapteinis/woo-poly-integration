<?xml version="1.0"?>
<ruleset name="WooCommerce Polylang Integration">
    <description>Coding standards for WooCommerce Polylang Integration</description>

    <!-- What to scan -->
    <file>src</file>

    <!-- Exclude patterns -->
    <exclude-pattern>vendor/</exclude-pattern>
    <exclude-pattern>tests/wordpress/</exclude-pattern>
    <exclude-pattern>node_modules/</exclude-pattern>
    <exclude-pattern>*.js</exclude-pattern>
    <exclude-pattern>*.css</exclude-pattern>

    <!-- Show progress and sniff codes -->
    <arg value="ps"/>

    <!-- Use colors in output -->
    <arg name="colors"/>

    <!-- Check up to 8 files simultaneously -->
    <arg name="parallel" value="8"/>

    <!-- Include WordPress Coding Standards -->
    <rule ref="WordPress">
        <!-- Allow short array syntax -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>

        <!-- Allow short ternary syntax -->
        <exclude name="WordPress.PHP.DisallowShortTernary"/>

        <!-- Relax some strict WordPress rules for modern PHP -->
        <exclude name="WordPress.WP.AlternativeFunctions"/>
        <exclude name="WordPress.PHP.YodaConditions"/>
    </rule>

    <!-- Enforce PSR-12 naming conventions for classes -->
    <rule ref="PSR1.Classes.ClassDeclaration"/>

    <!-- Check for PHP cross-version compatibility -->
    <config name="testVersion" value="7.4-"/>

    <!-- Text domain consistency -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="woo-poly-integration"/>
                <element value="hyyan-woocommerce-polylang-integration"/>
            </property>
        </properties>
    </rule>

    <!-- Namespace and class name rules -->
    <rule ref="PSR1.Files.SideEffects"/>

    <!-- Security rules -->
    <rule ref="WordPress.Security"/>

    <!-- Allow for backward compatibility -->
    <rule ref="WordPress.NamingConventions.ValidVariableName">
        <properties>
            <property name="customPropertiesWhitelist" type="array">
                <element value="ID"/>
            </property>
        </properties>
    </rule>
</ruleset>
