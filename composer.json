{
    "name": "hyyan/woo-poly-integration",
    "description": "Integrates Polylang with Woocommerce",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Hyyan Abo Fakher",
            "email": "hyyanaf@gmail.com",
            "homepage": "https://github.com/hyyan"
        }
    ],
    "support": {
        "issues": "https://github.com/hyyan/woo-poly-integration/issues"
    },
    "keywords": [
        "wordpress",
        "wordpress admin",
        "wordpress plugin",
        "wordpress muplugin",
        "polylang",
        "woocommerce",
        "polylang woocommerce integration",
        "hyyan",
        "bedrock",
        "gwp"
    ],
    "require": {
        "php": ">=7.4",
        "composer/installers": "~1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.0",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "phpstan/phpstan": "^1.10",
        "phpstan/extension-installer": "^1.3",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^1.1",
        "yoast/phpunit-polyfills": "^2.0",
        "php-stubs/wordpress-stubs": "^6.2",
        "php-stubs/woocommerce-stubs": "^9.0"
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "cs": "phpcs --standard=WordPress src/",
        "cs:fix": "phpcbf --standard=WordPress src/",
        "analyze": "phpstan analyze src/ --level=6",
        "analyze:max": "phpstan analyze src/ --level=max",
        "ci": [
            "@cs",
            "@analyze",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
