#!/bin/bash
#
# Pre-commit hook for WooCommerce Polylang Integration
#
# This hook runs code quality checks before allowing a commit.
# To install: cp .git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit checks...${NC}\n"

# Check if composer is installed
if ! command -v composer &> /dev/null; then
    echo -e "${RED}Error: Composer is not installed${NC}"
    exit 1
fi

# Check if vendor directory exists
if [ ! -d "vendor" ]; then
    echo -e "${YELLOW}Installing dependencies...${NC}"
    composer install --quiet
fi

# Get list of staged PHP files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}No PHP files to check${NC}"
    exit 0
fi

echo -e "${YELLOW}Checking PHP files:${NC}"
echo "$STAGED_FILES"
echo ""

# Run PHP Lint
echo -e "${YELLOW}1. Running PHP Lint...${NC}"
for FILE in $STAGED_FILES; do
    php -l "$FILE" > /dev/null 2>&1
    if [ $? -ne 0 ]; then
        echo -e "${RED}PHP Lint failed for $FILE${NC}"
        exit 1
    fi
done
echo -e "${GREEN}✓ PHP Lint passed${NC}\n"

# Run PHPCS on staged files
echo -e "${YELLOW}2. Running PHP CodeSniffer...${NC}"
vendor/bin/phpcs --standard=WordPress $STAGED_FILES
if [ $? -ne 0 ]; then
    echo -e "${RED}✗ Code style issues found${NC}"
    echo -e "${YELLOW}Run 'composer cs:fix' to automatically fix some issues${NC}"
    exit 1
fi
echo -e "${GREEN}✓ Code style check passed${NC}\n"

# Run PHPStan (only on src files)
SRC_FILES=$(echo "$STAGED_FILES" | grep '^src/' || true)
if [ -n "$SRC_FILES" ]; then
    echo -e "${YELLOW}3. Running PHPStan static analysis...${NC}"
    vendor/bin/phpstan analyze $SRC_FILES --level=6 --no-progress
    if [ $? -ne 0 ]; then
        echo -e "${RED}✗ Static analysis found issues${NC}"
        exit 1
    fi
    echo -e "${GREEN}✓ Static analysis passed${NC}\n"
else
    echo -e "${YELLOW}3. Skipping PHPStan (no src files changed)${NC}\n"
fi

# Run tests (optional - can be commented out if too slow)
echo -e "${YELLOW}4. Running tests...${NC}"
vendor/bin/phpunit --testsuite="Unit Tests" --no-coverage
if [ $? -ne 0 ]; then
    echo -e "${RED}✗ Tests failed${NC}"
    echo -e "${YELLOW}Fix failing tests before committing${NC}"
    exit 1
fi
echo -e "${GREEN}✓ Tests passed${NC}\n"

echo -e "${GREEN}All pre-commit checks passed! ✨${NC}"
exit 0
